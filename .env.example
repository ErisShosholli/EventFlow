# Postgres connection string (Supabase, Neon, or any Postgres provider).
# For a zero-install local DB, run `npx prisma dev --name eventflow --detach`
# and use the TCP URL it prints (see README "Local database" section).
DATABASE_URL="postgresql://user:password@localhost:5432/eventflow?schema=public"

# Only needed by `prisma migrate dev` when the database server can't create
# its own shadow database (e.g. the local `prisma dev` server, whose shadow
# instance runs on a separate port).
SHADOW_DATABASE_URL=

# NextAuth (Auth.js)
# Generate a secret with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (image storage for the QR photo wall)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (payments — leave blank to disable checkout in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
